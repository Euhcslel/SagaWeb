# База данных (хост "postgres" — имя сервиса в docker-compose)
DB_CONNECTION=postgres://postgres:5432@postgres/saga?sslmode=disable

# Goose — миграции
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:5432@postgres/saga?sslmode=disable
GOOSE_MIGRATION_DIR=./migrations

# Пути к Excel-файлам с размерами
# Смонтируйте папку с xlsx-файлами как volume и укажите пути ниже
EXCEL_IMPORT_IND_DEALER_PATH=/app/data/sizes/prom_dealer_sizes.xlsx
EXCEL_IMPORT_IND_CLIENT_PATH=/app/data/sizes/prom_client_sizes.xlsx
EXCEL_IMPORT_RES_DEALER_PATH=/app/data/sizes/home_dealer_sizes.xlsx
EXCEL_IMPORT_RES_CLIENT_PATH=/app/data/sizes/home_client_sizes.xlsx

# Директории для хранения документов
CONTRACTS_DIRECTORY=/app/data/contracts
BILLS_DIRECTORY=/app/data/bills
OFFERS_DIRECTORY=/app/data/offers
DOCUMENTS_DIRECTORY=/app/data/documents
IMAGES_DIRECTORY=/app/data/images

# SMTP
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=test-saga-email@yandex.com
SMTP_PASSWORD=xwzvamwajkjeqrbg
SMTP_FROM_EMAIL=test-saga-email@yandex.com
