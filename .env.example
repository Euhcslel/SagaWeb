# PostgreSQL credentials (используются docker-compose для создания контейнера)
POSTGRES_DB=saga
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# База данных (локальная разработка — хост localhost)
# Для docker-контейнеров используется .env.docker с хостом "postgres"
DB_CONNECTION="postgres://postgres:your_postgres_password@localhost/saga?sslmode=disable"

# Goose — миграции
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:your_postgres_password@localhost/saga?sslmode=disable
GOOSE_MIGRATION_DIR=./migrations

# Пути к Excel-файлам с размерами
# Локальная разработка:
EXCEL_IMPORT_IND_DEALER_PATH="./data/sizes_import/prom_dealer_sizes.xlsx"
EXCEL_IMPORT_IND_CLIENT_PATH="./data/sizes_import/prom_client_sizes.xlsx"
EXCEL_IMPORT_RES_DEALER_PATH="./data/sizes_import/home_dealer_sizes.xlsx"
EXCEL_IMPORT_RES_CLIENT_PATH="./data/sizes_import/home_client_sizes.xlsx"
# Docker (.env.docker): путь /app/data/sizes_import/...

# Директории для хранения документов
CONTRACTS_DIRECTORY="./data/contracts"
BILLS_DIRECTORY="./data/bills"
OFFERS_DIRECTORY="./data/offers"
DOCUMENTS_DIRECTORY="./data/documents"
IMAGES_DIRECTORY="./data/images"

# Реквизиты компании-производителя
COMPANY_NAME="ООО «САГА»"
COMPANY_INN=0000000000
COMPANY_KPP=000000000
COMPANY_REPRESENTATIVE="Фамилия И.О."
WARRANTY_EQUIPMENT="12 месяцев"
WARRANTY_AUTOMATION="24 месяца"
OFFER_VALIDITY_DAYS=14
CONTRACT_TEMPLATE_PATH="data/contract_template/contract_template.docx"

# SMTP
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="587"
SMTP_USER="your-email@yandex.com"
SMTP_PASSWORD="your_smtp_app_password"
SMTP_FROM_EMAIL="your-email@yandex.com"
